.claude
build*
# The frozen simulation project (sim/vl/freeze.sh of the Coyote submodule) keeps its generated sources under build/
!hardware/sim_frozen/build/

# Generated unit test files
hardware/unit-tests/diff/**
hardware/unit-tests/sim_dump.vcd

# Vivado generated files
.Xil
*.jou
*.log
*.str
.nfs*

# Python
*.pyc
__pycache__

# MacOS DS_Store files
.DS_Store
._.DS_Store
**/.DS_Store
**/._.DS_Store
